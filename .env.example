# Copy to .env (untracked) and fill in local values. Never commit .env.
# Use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and each AI request waited ~5 s (D-046).
# Read by compose.yaml (database container) and by the backend (imported from ../.env).

# Local database container
POSTGRES_USER=pantrychef
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
PANTRYCHEF_DB_PORT=5440

# Backend database connection (must match the values above)
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5440/pantrychef
SPRING_DATASOURCE_USERNAME=pantrychef
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD

# Backend auth: at least 32 random bytes, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_SECRET=REPLACE_WITH_HIGH_ENTROPY_LOCAL_SECRET
JWT_ISSUER=pantrychef-local

# App settings (optional; these are the defaults)
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR

# Backend -> AI service (server-side only; never exposed to the browser). At least 32 random characters.
FASTAPI_BASE_URL=http://127.0.0.1:8000
SERVICE_TO_SERVICE_SECRET=REPLACE_WITH_LOCAL_ONLY_SECRET

# AI service database access: read-only role (see README for enabling its login) and the import's owner role
AI_DATABASE_URL=postgresql://pantrychef_ai:REPLACE_WITH_AI_ROLE_PASSWORD@127.0.0.1:5440/pantrychef
INGEST_DATABASE_URL=postgresql://pantrychef:REPLACE_WITH_LOCAL_DB_PASSWORD@127.0.0.1:5440/pantrychef
